{
  "version": 2,
  "builds": [
    {
      "src": "frontend/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/client/dist"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/client/dist/index.html" }
  ],
  "outputDirectory": "frontend/client/dist"
}
